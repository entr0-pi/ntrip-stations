# Production .env Example for RTK2GO Station Finder
#
# Copy to /opt/ntrip-stations/.env and update values for your deployment

# ============================================================================
# Authentication
# Generate secrets: python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================
# API key users enter on the login page to receive a JWT
API_KEY=change-me-strong-random-key
# Secret used to sign JWTs (keep this secret!)
JWT_SECRET_KEY=change-me-another-strong-random-secret

# ============================================================================
# Application Runtime Configuration
# ============================================================================
# Set to "production" for online deployment (uses 127.0.0.1, disables reload)
ENVIRONMENT=production

# Server host binding
# Format: IP address or hostname
# Examples:
#   SERVER_HOST=127.0.0.1       # Localhost only (behind reverse proxy) - recommended
#   SERVER_HOST=0.0.0.0         # All interfaces (direct access, development only)
#   SERVER_HOST=10.0.0.5        # Specific internal IP
# Default: Auto-selected based on ENVIRONMENT (127.0.0.1 for production)
SERVER_HOST=127.0.0.1

# ============================================================================
# Geocoding API (Geoapify)
# Get your free key at: https://www.geoapify.com/
# ============================================================================
GEOAPIFY_API_KEY=your_actual_api_key_here

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Search endpoint rate limit (format: <count>/<unit> where unit is second/minute/hour/day)
# Examples:
#   GEOAPIFY_API_RATE_LIMIT=5/second      # 5 requests per second (default, recommended)
#   GEOAPIFY_API_RATE_LIMIT=10/second     # 10 requests per second
#   GEOAPIFY_API_RATE_LIMIT=100/minute    # 100 requests per minute
#   GEOAPIFY_API_RATE_LIMIT=1000/hour     # 1000 requests per hour
#   GEOAPIFY_API_RATE_LIMIT=10000/day     # 10000 requests per day
# Rate limit is enforced server-side per IP address (per reverse proxy)
GEOAPIFY_API_RATE_LIMIT=5/second

# Database refresh endpoint rate limit (prevent excessive RTK2GO downloads)
# Format: <count>/<unit> where unit is second/minute/hour/day
# Examples:
#   REFRESH_DB_RATE_LIMIT=1/day       # Once per day (recommended)
#   REFRESH_DB_RATE_LIMIT=2/day       # Twice per day (every 12 hours)
#   REFRESH_DB_RATE_LIMIT=6/day       # 6 times per day (every 4 hours)
#   REFRESH_DB_RATE_LIMIT=24/day      # 24 times per day (every hour)
#   REFRESH_DB_RATE_LIMIT=1/hour      # Once per hour
#   REFRESH_DB_RATE_LIMIT=30/minute   # Every 2 minutes
# The rate limit compares current time with last update timestamp in database
REFRESH_DB_RATE_LIMIT=1/day

# ============================================================================
# /refresh Endpoint Authentication (optional; endpoint is open if unset)
# ============================================================================
# If ADMIN_TOKEN is set, POST /refresh requires: -H "X-Admin-Token: <token>"
# Generate a strong token: python3 -c "import secrets; print(secrets.token_hex(32))"
# If both ADMIN_TOKEN and REFRESH_ALLOWED_IPS are set, requests must satisfy both checks.
# Examples:
#   ADMIN_TOKEN=your_secret_token_here
#   ADMIN_TOKEN=3f2a1b...  (a 64-char hex string from secrets.token_hex(32))
# Uncomment and set to require token authentication:
# ADMIN_TOKEN=your_secret_token_here

# If REFRESH_ALLOWED_IPS is set, only listed IPs can call POST /refresh
# Format: comma-separated IP addresses (spaces are stripped automatically)
# Examples:
#   REFRESH_ALLOWED_IPS=127.0.0.1
#   REFRESH_ALLOWED_IPS=192.168.1.10,10.0.0.5
# Uncomment and set to restrict access by IP:
# REFRESH_ALLOWED_IPS=127.0.0.1

# Browser-side search button cooldown (seconds) - for UX feedback
BROWSER_SEARCH_COOLDOWN_SECS=2

# Optional docs protection (if unset, /docs and /openapi.json stay hidden)
DOCS_ADMIN_USER=admin
DOCS_ADMIN_PASSWORD=change-me

# ============================================================================
# RTK2GO NTRIP Server Configuration
# ============================================================================
RTK2GO_HOST=rtk2go.com
RTK2GO_PORT=2101
RTK2GO_TIMEOUT_SECS=30
RTK2GO_MAX_BYTES_MB=4

# ============================================================================
# Distance Badge Configuration
# Color-coded badges for station distance in results table
# ============================================================================
# Threshold 1 (green badge): distance <= this value (km)
DISTANCE_BADGE_GREEN_KM=100

# Threshold 2 (yellow badge): distance > green_threshold AND <= this value (km)
DISTANCE_BADGE_YELLOW_KM=300

# Threshold 3 (red badge): distance > yellow_threshold (km)

# ============================================================================
# Earth radius for distance calculations (km)
# Standard value: 6371.0 km
# ============================================================================
EARTH_RADIUS_KM=6371.0

# ============================================================================
# Reverse Proxy Configuration
# CRITICAL for rate limiting to work correctly behind nginx
# ============================================================================
# List of trusted proxy IPs that can set X-Forwarded-For header
# Set to nginx server IP if not on same machine (usually 127.0.0.1 for local proxy)
TRUSTED_HOSTS=127.0.0.1

# ============================================================================
# Host Header Validation (Security)
# Set this to your actual domain(s) to prevent Host header injection attacks
# Example: "rtk2go-finder.example.com,www.rtk2go-finder.example.com"
# Use "*" to allow any host (NOT RECOMMENDED for production)
# ============================================================================
ALLOWED_HOSTS=rtk2go-finder.example.com,www.rtk2go-finder.example.com

