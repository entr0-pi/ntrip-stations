# Production .env Example for RTK2GO Station Finder
#
# Copy to /opt/ntrip-stations/.env and update values for your deployment

# ============================================================================
# CRITICAL: Set to "production" to bind to 127.0.0.1 (behind nginx)
# ============================================================================
ENVIRONMENT=production

# ============================================================================
# Geocoding API (Geoapify)
# Get your free key at: https://www.geoapify.com/
# ============================================================================
GEOAPIFY_API_KEY=your_actual_api_key_here

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Search endpoint rate limit (format: <count>/<unit> where unit is second/minute/hour/day)
GEOAPIFY_API_RATE_LIMIT=5/second

# Database refresh endpoint rate limit (prevent excessive RTK2GO downloads)
REFRESH_DB_RATE_LIMIT=1/day

# Browser-side search button cooldown (seconds) - for UX feedback
BROWSER_SEARCH_COOLDOWN_SECS=2

# ============================================================================
# RTK2GO NTRIP Server Configuration
# ============================================================================
RTK2GO_HOST=rtk2go.com
RTK2GO_PORT=2101
RTK2GO_TIMEOUT_SECS=30
RTK2GO_MAX_BYTES_MB=4

# ============================================================================
# Earth radius for distance calculations (km)
# Standard value: 6371.0 km
# ============================================================================
EARTH_RADIUS_KM=6371.0

# ============================================================================
# Reverse Proxy Configuration
# CRITICAL for rate limiting to work correctly behind nginx
# ============================================================================
# List of trusted proxy IPs that can set X-Forwarded-For header
# Set to nginx server IP if not on same machine (usually 127.0.0.1 for local proxy)
TRUSTED_HOSTS=127.0.0.1

# ============================================================================
# Host Header Validation (Security)
# Set this to your actual domain(s) to prevent Host header injection attacks
# Example: "rtk2go-finder.example.com,www.rtk2go-finder.example.com"
# Use "*" to allow any host (NOT RECOMMENDED for production)
# ============================================================================
ALLOWED_HOSTS=rtk2go-finder.example.com,www.rtk2go-finder.example.com
